# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virar_organics?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# ---- Seed accounts (used by `npm run db:seed`; REQUIRED when NODE_ENV=production) ----
SEED_ADMIN_NAME="Virar Admin"
SEED_ADMIN_EMAIL=admin@virarorganics.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SALES_NAME="Sales Executive"
SEED_SALES_EMAIL=sales@virarorganics.test
SEED_SALES_PASSWORD=Sales@12345
SEED_CUSTOMER_NAME="Demo Customer"
SEED_CUSTOMER_EMAIL=customer@virarorganics.test
SEED_CUSTOMER_PASSWORD=Customer@12345

# ---- Razorpay (Test Mode) - used from Phase 2 / Phase 4 ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
